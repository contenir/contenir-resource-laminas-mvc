{
    "name": "contenir/contenir-resource-laminas-mvc",
    "description": "laminas-mvc adapter for contenir/contenir-resource: workflow routing and navigation for Contenir resources, a route listener that resolves the routed resource and its page metadata, the resource() controller plugin and the resource, resourceMeta, resourceUrl and resourceContent view helpers.",
    "type": "library",
    "license": "BSD-3-Clause",
    "keywords": [
        "contenir",
        "laminas",
        "mvc",
        "resource",
        "metadata",
        "seo"
    ],
    "homepage": "https://contenir.com.au",
    "support": {
        "docs": "https://github.com/contenir/contenir-resource-laminas-mvc/tree/main/docs",
        "issues": "https://github.com/contenir/contenir-resource-laminas-mvc/issues",
        "source": "https://github.com/contenir/contenir-resource-laminas-mvc"
    },
    "require": {
        "contenir/contenir-db-model": "^2.0@RC",
        "contenir/contenir-metadata": "^2.0",
        "contenir/contenir-resource": "^2.0@RC",
        "contenir/contenir-workflow-laminas-mvc": "^2.1",
        "laminas/laminas-eventmanager": "^3.14",
        "laminas/laminas-http": "^2.19",
        "laminas/laminas-mvc": "^3.8",
        "laminas/laminas-router": "^3.13",
        "laminas/laminas-servicemanager": "^3.22",
        "laminas/laminas-stdlib": "^3.19",
        "laminas/laminas-view": "^2.36",
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "psr/container": "^1.1 || ^2.0"
    },
    "require-dev": {
        "contenir/contenir-qa-tools": "0.1.x-dev",
        "infection/infection": "^0.34.1",
        "laminas/laminas-cache-storage-adapter-memory": "^2.3",
        "php-db/phpdb-sqlite": "0.3.x-dev",
        "phpunit/phpunit": "^11.5.42"
    },
    "conflict": {
        "laminas/laminas-stdlib": "<3.21"
    },
    "autoload": {
        "psr-4": {
            "Contenir\\Resource\\Laminas\\Mvc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\Resource\\Laminas\\Mvc\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration",
            "@mutation-test"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "mutation-test": "infection"
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "extra": {
        "laminas": {
            "component": "Contenir\\Resource\\Laminas\\Mvc",
            "config-provider": "Contenir\\Resource\\Laminas\\Mvc\\ConfigProvider"
        },
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
